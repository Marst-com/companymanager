rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function mem(c) { return exists(/databases/$(db)/documents/companies/$(c)/members/$(request.auth.uid)); }
    function me(c)  { return get(/databases/$(db)/documents/companies/$(c)/members/$(request.auth.uid)).data; }
    function txt()  { return request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() < 2000; }
    match /users/{u} { allow read: if request.auth != null && request.auth.uid == u; }
    // 쓰기는 전부 백엔드(Admin SDK)만. 클라이언트는 메시지·회의 신호만 쓸 수 있음.
    match /companies/{c} {
      allow read: if request.auth != null && mem(c);
      match /members/{u} { allow read: if request.auth != null && mem(c); }
      match /wallets/{u} {
        allow read: if request.auth != null && mem(c) && (me(c).role == 'owner' || request.auth.uid == u);
        match /ledger/{l} { allow read: if request.auth != null && mem(c) && (me(c).role == 'owner' || request.auth.uid == u); }
      }
      match /announcements/{a} {
        allow read: if request.auth != null && mem(c);
        allow create: if request.auth != null && mem(c) && me(c).role == 'owner' && request.resource.data.title is string && request.resource.data.title.size() < 80 && request.resource.data.body is string && request.resource.data.body.size() < 1000;
        allow delete: if request.auth != null && mem(c) && me(c).role == 'owner';
      }
      match /items/{i}   { allow read: if request.auth != null && mem(c); }
      match /orders/{o}  { allow read: if request.auth != null && mem(c) && (me(c).role == 'owner' || resource.data.uid == request.auth.uid); }
      match /chat/{m} { allow read: if request.auth != null && mem(c); allow create: if request.auth != null && mem(c) && txt(); }
      match /teams/{t} {
        allow read: if request.auth != null && mem(c);
        match /tasks/{k} {
          allow read, delete: if request.auth != null && mem(c) && (me(c).role == 'owner' || me(c).teamId == t);
          allow create, update: if request.auth != null && mem(c) && (me(c).role == 'owner' || me(c).teamId == t) && request.resource.data.title is string && request.resource.data.title.size() < 100 && request.resource.data.status in ['todo', 'doing', 'done'];
        }
        match /messages/{m} {
          allow read: if request.auth != null && mem(c) && (me(c).role == 'owner' || me(c).teamId == t);
          allow create: if request.auth != null && mem(c) && (me(c).role == 'owner' || me(c).teamId == t) && txt();
        }
      }
      match /dms/{p}/messages/{m} {
        allow read: if request.auth != null && request.auth.uid in p.split('_');
        allow create: if request.auth != null && request.auth.uid in p.split('_') && txt();
      }
      match /meetings/{mt} {
        allow read: if request.auth != null && mem(c);
        function ok() { return request.auth != null && mem(c) && (me(c).role == 'owner'
          || get(/databases/$(db)/documents/companies/$(c)/meetings/$(mt)).data.type == 'all'
          || get(/databases/$(db)/documents/companies/$(c)/meetings/$(mt)).data.teamId == me(c).teamId); }
        match /messages/{m} { allow read: if ok(); allow create: if ok() && txt(); }
        match /peers/{u} { allow read: if ok(); allow write: if ok() && u == request.auth.uid; }
        match /signals/{s} {
          allow read, delete: if ok() && resource.data.to == request.auth.uid;
          allow create: if ok() && request.resource.data.from == request.auth.uid;
        }
      }
    }
  }
}
